# Copie para .env. Nunca commite o .env.
HERMES_LLM_PROVIDER=gemini        # gemini | openai
HERMES_LLM_MODEL=                 # vazio = padrão do provedor
HERMES_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite  # usado se o principal der 503
GEMINI_API_KEY=
OPENAI_API_KEY=
HERMES_SCORE_MIN=60
HERMES_DATA_DIR=data
HERMES_SEARCHES_FILE=searches.yaml
HERMES_PROFILE_FILE=profile.md
TELEGRAM_TOKEN=                   # do @BotFather
TELEGRAM_CHAT_ID=                 # o bot só responde a este chat
HERMES_SEARCH_EVERY_HOURS=2
HERMES_DIGEST_HOUR=8

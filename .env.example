# Copie para .env. Nunca commite o .env.
HERMES_LLM_ENABLED=true           # false = sem nota, só o filtro de título
HERMES_LLM_PROVIDER=gemini        # gemini | openai
HERMES_LLM_MODEL=                 # vazio = padrão do provedor
HERMES_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite  # usado se o principal der 503
GEMINI_API_KEY=
OPENAI_API_KEY=
HERMES_SCORE_MIN=60
HERMES_DATA_DIR=data
HERMES_SEARCHES_FILE=searches.yaml
HERMES_PROFILE_FILE=profile.md
TELEGRAM_TOKEN=                   # do @BotFather
TELEGRAM_CHAT_ID=                 # o bot só responde a este chat
HERMES_SEARCH_EVERY_HOURS=2
HERMES_REMEMBER_DAYS=7            # modo canal: dias que a memória lembra uma vaga postada
HERMES_DIGEST_HOUR=8
DISCORD_WEBHOOK_URL=              # webhook do canal; vazio = só Telegram
GMAIL_ADDRESS=                    # Gmail que recebe o redirecionamento do Outlook
GMAIL_APP_PASSWORD=               # senha de app (myaccount.google.com/apppasswords)
HERMES_MAIL_ONLY_TO=              # o endereço do Outlook: só e-mails para ele são lidos
HERMES_MAIL_EVERY_MINUTES=15
